# Copy to .env and adjust. Every setting is optional for local development.
# .env is git-ignored; never commit real secrets.

# dev | test | prod  (prod requires CS_SECRET_KEY)
CS_ENV=dev
# Signs session cookies. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# CS_SECRET_KEY=paste-generated-value-here

# Detection: auto (use the AI model if installed) | detoxify | none (word lists only)
CS_SCORER=auto

# Infrastructure. Leave CS_REDIS_URL empty to run everything in one process.
CS_DATABASE_URL=sqlite+aiosqlite:///instance/cybershield.db
# CS_REDIS_URL=
# Examples for the production setup:
# CS_DATABASE_URL=postgresql+asyncpg://cybershield:cybershield@localhost:5432/cybershield
# CS_REDIS_URL=redis://localhost:6379/0
