# Copy to .env and adjust. Every setting is optional for local development.
# .env is git-ignored; never commit real secrets.

# dev | test | prod  (prod requires MODSTREAM_SECRET_KEY)
MODSTREAM_ENV=dev
# Signs session cookies. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# MODSTREAM_SECRET_KEY=paste-generated-value-here

# Detection: auto (use the AI model if installed) | detoxify | none (word lists only)
MODSTREAM_SCORER=auto

# Infrastructure. Leave MODSTREAM_REDIS_URL empty to run everything in one process.
MODSTREAM_DATABASE_URL=sqlite+aiosqlite:///instance/modstream.db
# MODSTREAM_REDIS_URL=
# Examples for the production setup:
# MODSTREAM_DATABASE_URL=postgresql+asyncpg://modstream:modstream@localhost:5432/modstream
# MODSTREAM_REDIS_URL=redis://localhost:6379/0
